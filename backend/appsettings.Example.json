{
  "//": "Copy this file to appsettings.json OR set these via user-secrets / environment variables.",
  "//secrets": "Never commit real secrets. Use: dotnet user-secrets set \"Jwt:Secret\" \"...\"",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG"
  },
  "Seed": {
    "SuperAdminPassword": "REPLACE_IN_PRODUCTION"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "S3": {
      "ServiceUrl": "https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3",
      "PublicBaseUrl": "https://YOUR_PROJECT.supabase.co/storage/v1/object/public/food-images",
      "Bucket": "food-images",
      "AccessKeyId": "REPLACE_WITH_ROTATED_ACCESS_KEY",
      "SecretAccessKey": "REPLACE_WITH_ROTATED_SECRET_KEY"
    }
  }
}
